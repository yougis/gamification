{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://geoplay.example/schemas/modules/difference-game.json",
  "title": "DIFFERENCE_GAME module data (change 500)",
  "type": "object",
  "required": ["schemaVersion", "polygons"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "source": {"type": "string"},
    "derivee": {"type": "string"},
    "polygons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["x", "y", "w", "h"],
        "additionalProperties": false,
        "properties": {
          "x": {"type": "number", "minimum": 0, "maximum": 100},
          "y": {"type": "number", "minimum": 0, "maximum": 100},
          "w": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
          "h": {"type": "number", "exclusiveMinimum": 0, "maximum": 100}
        }
      }
    },
    "touchDilatation": {"type": "number", "minimum": 0},
    "simplifyPx": {"type": "number", "minimum": 0},
    "inventoryHints": {"$ref": "https://geoplay.example/schemas/modules/inventory-hints.json"}
  },
  "x-needs": {"gps": false, "compass": false, "camera": false, "map": false},
  "x-fallback": "dilatation tactile minimale 44 px (jouable gante)"
}
