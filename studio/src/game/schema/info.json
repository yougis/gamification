{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://geoplay.example/schemas/modules/info.json",
  "title": "INFO module data (change module-info-story)",
  "type": "object",
  "required": ["schemaVersion", "steps"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {"type": "string"},
          "image": {"type": "string"},
          "video": {"type": "string"},
          "audio": {"type": "string"}
        },
        "anyOf": [
          {"required": ["text"]},
          {"required": ["image"]},
          {"required": ["video"]},
          {"required": ["audio"]}
        ]
      }
    },
    "inventoryHints": {"$ref": "https://geoplay.example/schemas/modules/inventory-hints.json"}
  },
  "x-needs": {"gps": false, "compass": false, "camera": false, "map": false},
  "x-fallback": "aucun (récit sans capteur)"
}
