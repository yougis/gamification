{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://geoplay.example/schemas/game-schema-1.0.0.json",
  "title": "GeoPlay Game",
  "description": "Socle 100 : structure opposable d'un Jeu. Les regles de graphe non exprimables ici (cycles, atteignabilite, topo pools, drawCount<=len, unicite) vivent dans le validateur applicatif.",
  "type": "object",
  "required": ["gameId", "schemaVersion", "minEngineVersion", "nodes"],
  "additionalProperties": false,
  "properties": {
    "gameId": {"type": "string", "minLength": 1},
    "schemaVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "minEngineVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "branding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "primaryColor": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
        "secondaryColor": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
        "fontFamily": {"type": "string"},
        "logo": {"type": "string"}
      }
    },
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gpsRadiusMeters": {"type": "number", "exclusiveMinimum": 0},
        "map": {"type": "object"},
        "gpxTrace": {"type": "object"},
        "holdMode": {
          "type": "string",
          "enum": ["none", "guidedAccess", "screenPinning", "lockTask"],
          "default": "none"
        },
        "holdExit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": {"type": "string", "enum": ["adminPin", "adminGesture", "adminQR", "animateurCode"]},
            "pin": {"type": "string", "minLength": 4},
            "adminPanel": {"type": "object", "properties": {"enabled": {"type": "boolean"}}}
          }
        },
        "navigationModel": {
          "type": "string",
          "enum": ["BASIC", "GUIDED", "TREASURE_HUNT", "ESCAPE_GAME", "OPEN_EXPLORATION"],
          "default": "BASIC"
        },
        "presentation": {
          "type": "array",
          "items": {"type": "string", "enum": ["MAP", "LIST", "STORY", "CLUE", "TOOLBOX", "TIMELINE", "HOME"]}
        },
        "experienceStyle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "preset": {"type": "string", "enum": ["BASIC", "GUIDED", "TREASURE_HUNT", "ESCAPE_GAME", "OPEN_EXPLORATION"]},
            "identity": {"type": "object", "additionalProperties": false, "properties": {"name": {"type": "string"}, "publisher": {"type": "string"}, "logo": {"type": "string"}, "theme": {"type": "string"}}},
            "visual": {"type": "object", "additionalProperties": false, "properties": {"primaryColor": {"type": "string"}, "secondaryColor": {"type": "string"}, "fontFamily": {"type": "string"}, "borderRadius": {"type": "integer", "minimum": 0}, "cardStyle": {"type": "string"}}},
            "components": {"type": "object"},
            "media": {"type": "object"},
            "motion": {"type": "object"},
        "map": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": {"type": "string"},
            "bbox": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "minLat": {"type": "number", "minimum": -90, "maximum": 90},
                "minLng": {"type": "number", "minimum": -180, "maximum": 180},
                "maxLat": {"type": "number", "minimum": -90, "maximum": 90},
                "maxLng": {"type": "number", "minimum": -180, "maximum": 180}
              }
            },
            "minZoom": {"type": "number", "minimum": 0, "maximum": 22},
            "maxZoom": {"type": "number", "minimum": 0, "maximum": 22},
            "attribution": {"type": "string"}
          }
        },
            "voice": {"type": "object"}
          }
        },
        "gameMode": {
          "type": "string",
          "enum": ["NORMAL", "ANIMATEUR", "SOIREE", "HARDCORE"]
        },
        "difficulty": {
          "type": "string",
          "enum": ["ENFANT", "FAMILLE", "EXPERT"]
        },
        "dureeTotale": {"type": "integer", "minimum": 0},
        "finDeTemps": {
          "type": "string",
          "enum": ["terminer", "continuer"]
        },
        "indoorPlans": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "floor", "image", "origin", "scale", "sizeMeters"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "name": {"type": "string"},
              "floor": {"type": "integer"},
              "image": {"type": "string"},
              "origin": {
                "type": "object",
                "required": ["lat", "lng"],
                "additionalProperties": false,
                "properties": {
                  "lat": {"type": "number", "minimum": -90, "maximum": 90},
                  "lng": {"type": "number", "minimum": -180, "maximum": 180}
                }
              },
              "scale": {"type": "number", "exclusiveMinimum": 0},
              "sizeMeters": {
                "type": "object",
                "required": ["w", "h"],
                "additionalProperties": false,
                "properties": {
                  "w": {"type": "number", "exclusiveMinimum": 0},
                  "h": {"type": "number", "exclusiveMinimum": 0}
                }
              }
            }
          }
        },
        "tileStrategy": {
          "type": "string",
          "enum": ["fixed", "viewport", "radius", "none"]
        },
        "tileRadiusMeters": {"type": "number", "exclusiveMinimum": 0},
        "screen": {"$ref": "#/definitions/screen"},
        "minigameDefaults": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxAttempts": {"type": "integer", "minimum": 1},
            "timeLimitSeconds": {"type": "integer", "minimum": 0}
          }
        }
      },
      "allOf": [
        {"if": {"required": ["holdMode"], "properties": {"holdMode": {"enum": ["guidedAccess", "screenPinning", "lockTask"]}}}, "then": {"required": ["holdExit"]}},
        {"if": {"required": ["tileStrategy"], "properties": {"tileStrategy": {"const": "radius"}}}, "then": {"required": ["tileRadiusMeters"]}},
        {"if": {"required": ["dureeTotale"]}, "then": {"required": ["finDeTemps"]}}
      ]
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "required": ["isEnding"],
        "properties": {"isEnding": {"const": true}}
      },
      "items": {"$ref": "#/definitions/node"}
    },
    "objects": {
      "type": "array",
      "items": {"$ref": "#/definitions/object"}
    },
    "recipes": {
      "type": "array",
      "items": {"$ref": "#/definitions/recipe"}
    }
  },
  "definitions": {
    "node": {
      "type": "object",
      "required": ["id", "module", "activation"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "module": {
          "type": "object",
          "required": ["type", "data"],
          "additionalProperties": false,
          "properties": {
            "type": {"type": "string", "minLength": 1},
            "data": {"type": "object"}
          },
          "allOf": [
            {"if": {"properties": {"type": {"const": "QUIZ"}}}, "then": {"properties": {"data": {"$ref": "modules/quiz.json"}}}},
            {"if": {"properties": {"type": {"const": "DIFFERENCE_GAME"}}}, "then": {"properties": {"data": {"$ref": "modules/difference-game.json"}}}},
            {"if": {"properties": {"type": {"const": "PUZZLE"}}}, "then": {"properties": {"data": {"$ref": "modules/puzzle.json"}}}},
            {"if": {"properties": {"type": {"const": "AR_MARKER"}}}, "then": {"properties": {"data": {"$ref": "modules/ar-marker.json"}}}},
            {"if": {"properties": {"type": {"const": "BOUSSOLE"}}}, "then": {"properties": {"data": {"$ref": "modules/boussole.json"}}}},
            {"if": {"properties": {"type": {"const": "CODE_INPUT"}}}, "then": {"properties": {"data": {"$ref": "modules/code-input.json"}}}},
            {"if": {"properties": {"type": {"const": "INFO"}}}, "then": {"properties": {"data": {"$ref": "modules/info.json"}}}}
          ]
        },
        "activation": {
          "type": "object",
          "required": ["requires"],
          "additionalProperties": false,
          "properties": {
            "requires": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/condition"}},
            "operator": {"enum": ["AND", "OR"]},
            "latch": {"type": "boolean", "default": true}
          },
          "allOf": [
            {"if": {"properties": {"requires": {"minItems": 2}}}, "then": {"required": ["operator"]}},
            {"if": {"properties": {"requires": {"maxItems": 1}}}, "then": {"not": {"required": ["operator"]}}}
          ]
        },
        "latch": {"type": "boolean", "default": true},
        "inventoryAccess": {"type": "boolean", "default": true},
        "onReentry": {"enum": ["ignore", "replay"], "default": "ignore"},
        "maxReentries": {"type": "integer", "minimum": 1},
        "scoreOnReplay": {"type": "boolean", "default": false},
        "isEnding": {"type": "boolean", "default": false},
        "randomPool": {
          "type": "object",
          "required": ["candidates", "drawCount", "drawTiming"],
          "additionalProperties": false,
          "properties": {
            "candidates": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "drawCount": {"type": "integer", "minimum": 1},
            "drawTiming": {"enum": ["ON_POOL_ACTIVATION", "ON_GAME_START"]}
          }
        },
        "discovery": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {"type": "string", "enum": ["VISIBLE_NOW", "MAP", "ON_COMPLETED", "ON_CLUE", "ON_ITEM", "ON_PUZZLE", "ON_PROXIMITY", "ON_TIME"]},
            "sourceNode": {"type": "string", "minLength": 1},
            "clueId": {"type": "string", "minLength": 1},
            "itemId": {"type": "string", "minLength": 1},
            "lat": {"type": "number"},
            "lng": {"type": "number"},
            "radiusMeters": {"type": "number", "exclusiveMinimum": 0}
          },
          "allOf": [
            {"if": {"properties": {"mode": {"const": "ON_ITEM"}}}, "then": {"required": ["itemId"]}}
          ]
        },
        "effects": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": false, "properties": {"type": {"type": "string"}, "itemId": {"type": "string"}, "nodeId": {"type": "string"}, "variableId": {"type": "string"}, "value": {}}}},
        "inventoryRef": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "position": {
          "type": "object",
          "required": ["planId", "x", "y"],
          "additionalProperties": false,
          "properties": {
            "planId": {"type": "string", "minLength": 1},
            "x": {"type": "number"},
            "y": {"type": "number"}
          }
        },
        "screen": {"$ref": "#/definitions/screen"}
      },
      "allOf": [
        {"if": {"required": ["onReentry"], "properties": {"onReentry": {"const": "replay"}}}, "then": {"required": ["maxReentries"]}}
      ]
    },
    "condition": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        {
          "required": ["type", "lat", "lng", "radiusMeters", "predicate"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "GEOFENCE"},
            "lat": {"type": "number", "minimum": -90, "maximum": 90},
            "lng": {"type": "number", "minimum": -180, "maximum": 180},
            "radiusMeters": {"type": "number", "exclusiveMinimum": 0},
            "predicate": {"enum": ["enter", "exit", "dwell", "through"]},
            "dwellMs": {"type": "integer", "minimum": 0},
            "hysteresisMeters": {"type": "number", "minimum": 0},
            "maxAccuracyM": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        {
          "required": ["type", "nodeId"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "NODE_COMPLETED"},
            "nodeId": {"type": "string", "minLength": 1},
            "allowCycle": {"type": "boolean", "default": false}
          }
        },
        {
          "required": ["type", "anchor", "delaySeconds"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "TIMER"},
            "anchor": {"enum": ["GAME_START", "NODE_COMPLETION"]},
            "anchorNodeId": {"type": "string", "minLength": 1},
            "delaySeconds": {"type": "number", "minimum": 0}
          },
          "allOf": [
            {"if": {"properties": {"anchor": {"const": "NODE_COMPLETION"}}}, "then": {"required": ["anchorNodeId"]}}
          ]
        },
        {
          "required": ["type", "poolNodeId"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "POOL_DRAWN"},
            "poolNodeId": {"type": "string", "minLength": 1}
          }
        },
        {
          "required": ["type", "masterId", "transport"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "PROXIMITY_MASTER"},
            "masterId": {"type": "string", "minLength": 1},
            "transport": {"enum": ["ble", "wifi"]},
            "minRssiDbm": {"type": "number"},
            "dwellMs": {"type": "integer", "minimum": 0}
          }
        },
        {
          "required": ["type"],
          "properties": {"type": {"const": "CONDITIONAL"}}
        },
        {
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "WINDOW"},
            "apresSecondes": {"type": "number", "minimum": 0},
            "avantSecondes": {"type": "number", "minimum": 0}
          },
          "anyOf": [
            {"required": ["apresSecondes"]},
            {"required": ["avantSecondes"]}
          ]
        },
        {
          "required": ["type", "itemId"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "ITEM_REQUIRED"},
            "itemId": {"type": "string", "minLength": 1}
          }
        },
        {
          "required": ["type", "itemId"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "ITEM_USED"},
            "itemId": {"type": "string", "minLength": 1},
            "consumed": {"type": "boolean", "default": true}
          }
        },
        {
          "required": ["type", "code"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "CODE_INPUT"},
            "code": {"type": "string", "minLength": 1}
          }
        },
        {
          "required": ["type", "clueId"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "CLUE_RESOLVED"},
            "clueId": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "object": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "icon": {"type": "string"},
        "image": {"type": "string"},
        "description": {"type": "string"},
        "consumable": {"type": "boolean", "default": false},
        "stackable": {"type": "boolean", "default": true}
      }
    },
    "recipe": {
      "type": "object",
      "required": ["id", "inputs", "output"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "inputs": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["itemId"],
            "additionalProperties": false,
            "properties": {
              "itemId": {"type": "string", "minLength": 1},
              "consume": {"type": "boolean", "default": true}
            }
          }
        },
        "output": {"type": "string", "minLength": 1}
      }
    },
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layout": {"type": "string", "minLength": 1},
        "styles": {"$ref": "#/definitions/widgetStyles"},
        "background": {
          "type": "object",
          "required": ["type", "value"],
          "additionalProperties": false,
          "properties": {
            "type": {"enum": ["color", "image", "gradient"]},
            "value": {"type": "string"},
            "overlay": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "zones": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "header": {"$ref": "#/definitions/zoneContent"},
            "content": {"$ref": "#/definitions/zoneContent"},
            "footer": {"$ref": "#/definitions/zoneContent"},
            "overlay": {"$ref": "#/definitions/zoneContent"}
          }
        },
        "transitions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enter": {"enum": ["fade", "slide", "none"]},
            "exit": {"enum": ["fade", "slide", "none"]}
          }
        }
      }
    },
    "zoneContent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layout": {"enum": ["stack", "grid", "free"], "default": "stack"},
        "widgets": {"type": "array", "items": {"$ref": "#/definitions/widget"}},
        "fermable": {"type": "boolean", "default": false}
      }
    },
    "widgetStyles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fontFamily": {"type": "string"},
        "fontSize": {"type": "number", "exclusiveMinimum": 0},
        "fontWeight": {"enum": ["normal", "bold"]},
        "color": {"type": "string"},
        "align": {"enum": ["left", "center", "right"]},
        "backgroundColor": {"type": "string"},
        "textColor": {"type": "string"},
        "borderRadius": {"type": "number", "minimum": 0}
      }
    },
    "widget": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        {
          "required": ["type", "text"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "text"},
            "text": {"type": "string"},
            "style": {"enum": ["heading", "subtitle", "body", "caption"]},
            "fontSize": {"type": "number", "minimum": 0},
            "color": {"type": "string"},
            "align": {"enum": ["left", "center", "right"]},
            "styles": {"$ref": "#/definitions/widgetStyles"}
          }
        },
        {
          "required": ["type", "src"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "image"},
            "src": {"type": "string", "minLength": 1},
            "width": {"type": ["number", "string"]},
            "height": {"type": ["number", "string"]},
            "fit": {"enum": ["cover", "contain", "fill"]},
            "alt": {"type": "string"},
            "styles": {"$ref": "#/definitions/widgetStyles"}
          }
        },
        {
          "required": ["type", "label"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "button"},
            "label": {"type": "string"},
            "action": {"type": "string"},
            "icon": {"type": "string"},
            "variant": {"enum": ["primary", "secondary", "ghost"]},
            "styles": {"$ref": "#/definitions/widgetStyles"}
          }
        },
        {
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "progress"},
            "progressType": {"enum": ["steps", "score"]},
            "showLabel": {"type": "boolean"},
            "color": {"type": "string"},
            "styles": {"$ref": "#/definitions/widgetStyles"}
          }
        },
        {
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "module"},
            "styles": {"$ref": "#/definitions/widgetStyles"}
          }
        },
        {
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "spacer"},
            "height": {"type": ["number", "string"]},
            "styles": {"$ref": "#/definitions/widgetStyles"}
          }
        }
      ]
    }
  }
}
