{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://geoplay.example/schemas/modules/ar-marker.json",
  "title": "AR_MARKER module data (change 500)",
  "type": "object",
  "required": ["schemaVersion", "marker", "fallback2D"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "marker": {"type": "string", "minLength": 1},
    "model": {"type": "string"},
    "modelSizeMb": {"type": "number", "exclusiveMinimum": 0},
    "fallback2D": {"type": "object"}
  },
  "x-needs": {"gps": false, "compass": false, "camera": true, "map": false},
  "x-fallback": "fallback 2D obligatoire (soleil, permission, vieil appareil)"
}
