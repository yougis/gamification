{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://geoplay.example/schemas/modules/quiz.json",
  "title": "QUIZ module data (squelette 100, detail au change 500)",
  "type": "object",
  "required": ["schemaVersion", "questions"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "questions": {"type": "array", "minItems": 1},
    "timeLimitSeconds": {"type": "integer", "minimum": 0},
    "onTimeout": {"type": "string"}
  }
}
